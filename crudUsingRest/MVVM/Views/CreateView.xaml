<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.CreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="CreateView"
    x:DataType="vm:CRUDViewModel">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            FontAttributes="Bold"
            FontSize="24"
            HorizontalOptions="Center"
            Text="Create New Book" />

        <Entry x:Name="txtTitle" Placeholder="Enter Title" Text="{Binding Title}" />

        <Entry x:Name="txtAuthor" Placeholder="Enter Author" Text="{Binding Author}" />

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">


            <Button
                BackgroundColor="Black"
                Command="{Binding CreateBookCommand}"
                Clicked="Cancel_Clicked"
                Text="Save"
                TextColor="White"
                WidthRequest="120" />

            <Button
                BackgroundColor="Transparent"
                BorderColor="Black"
                BorderWidth="2"
                Clicked="Cancel_Clicked"
                Text="Cancel"
                TextColor="Black"
                WidthRequest="120" />

        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>