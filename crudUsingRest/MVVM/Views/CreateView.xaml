<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.CreateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="CreateView"
    x:DataType="vm:CRUDViewModel"
    BackgroundColor="{StaticResource FreshBg}">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            FontAttributes="Bold"
            FontSize="26"
            HorizontalOptions="Center"
            Style="{StaticResource FormTitleStyle}"
            Text="Add a New Story" />

        <Entry
            x:Name="txtTitle"
            Placeholder="Title"
            Style="{StaticResource FormEntryStyle}"
            Text="{Binding Title}" />

        <Entry
            x:Name="txtAuthor"
            Placeholder="Author"
            Style="{StaticResource FormEntryStyle}"
            Text="{Binding Author}" />

        <Button
            Command="{Binding SelectImageCommand}"
            Style="{StaticResource CreateButtonStyle}"
            Text="Select Picture" />

        <Border
            HeightRequest="180"
            HorizontalOptions="Center"
            Stroke="{StaticResource FreshBlue}"
            StrokeThickness="2"
            WidthRequest="180">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Image Aspect="AspectFill" Source="{Binding ImageBook}" />
        </Border>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">

            <Button
                Clicked="Cancel_Clicked"
                Command="{Binding CreateBookCommand}"
                Style="{StaticResource PrimaryButtonStyle}"
                Text="Save" />

            <Button
                Clicked="Cancel_Clicked"
                Style="{StaticResource ButtonCancel}"
                Text="Cancel" />

        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>