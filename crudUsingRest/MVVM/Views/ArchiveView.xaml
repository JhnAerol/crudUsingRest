<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="crudUsingRest.MVVM.Views.ArchiveView"
             xmlns:models="clr-namespace:crudUsingRest.MVVM.Models"
             xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
             x:DataType="vm:CRUDViewModel"
             Title="ArchiveView"
             BackgroundColor="#F9F6EE">

    <Grid
        Margin="10,15"
        RowDefinitions="Auto,*"
        RowSpacing="10">

        <!-- Header -->
        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,Auto"
            RowSpacing="8">

            <Button
                Grid.Row="0"
                Clicked="Back_Clicked"
                Style="{StaticResource CreateButtonStyle}"
                Text="Back To Main View"
                HorizontalOptions="Start" />

            <Label
                Grid.Row="1"
                Text="Archived"
                TextColor="Black"
                FontSize="20"
                FontAttributes="Bold" />
        </Grid>

        <!-- Archive Collection -->
        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding _softDeletedBooks}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    Orientation="Vertical"
                    Span="2"
                    HorizontalItemSpacing="10"
                    VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Style="{StaticResource BookCardBorder}">
                        <Grid RowDefinitions="Auto,*,Auto">

                    
                            <Image
                                Grid.Row="0"
                                HeightRequest="140"
                                Aspect="AspectFill"
                                Source="{Binding imagesBook}" />

                        
                            <VerticalStackLayout
                                Grid.Row="1"
                                Padding="10,10,10,0"
                                Spacing="4">

                                <Label
                                    Style="{StaticResource BookTitleLabel}"
                                    Text="{Binding title}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                                <Label
                                    Style="{StaticResource BookAuthorLabel}"
                                    Text="{Binding author}"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1" />

                                <Label
                                    Margin="0,8,0,0"
                                    FontSize="13"
                                    TextColor="#CC5500"
                                    Text="{Binding datePublished, StringFormat='{0:MMMM yyyy}'}" />

                            </VerticalStackLayout>

                            <Grid
                                Grid.Row="2"
                                Padding="10"
                                ColumnDefinitions="*,*"
                                ColumnSpacing="8"
                                >

                                <Button
                                    Grid.Column="0"
                                    Clicked="Update_Clicked"
                                    Style="{StaticResource UpdateActionButtonStyle}"
                                    Text="Update"
                                    CommandParameter="{Binding .}"
                                    />

                                <Button
                                    Grid.Column="1"
                                    Command="{Binding DeleteBookCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource DeleteActionButtonStyle}"
                                    Text="Delete"
                                  
                                    />

                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>