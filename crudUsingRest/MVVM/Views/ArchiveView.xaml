<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="crudUsingRest.MVVM.Views.ArchiveView"
             xmlns:models="clr-namespace:crudUsingRest.MVVM.Models"
             xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
             x:DataType="vm:CRUDViewModel"
             Title="ArchiveView">
    <Grid
        Margin="10,15"
        RowDefinitions="Auto,*"
        RowSpacing="5">
        <VerticalStackLayout HorizontalOptions="Start">
            <Button
                Clicked="Back_Clicked"
                Style="{StaticResource CreateButtonStyle}"
                Text="Back To Main View" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding _softDeletedBooks}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Style="{StaticResource BookCardBorder}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                            <Image
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                HeightRequest="140"
                                Aspect="AspectFill"
                                Source="{Binding imagesBook}" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="10"
                                Spacing="4">

                                <Label
                                    Style="{StaticResource BookTitleLabel}"
                                    Text="{Binding title}" />

                                <Label
                                    Style="{StaticResource BookAuthorLabel}"
                                    Text="{Binding author}" />

                                <Label
                                    Margin="0,24,0,0"
                                    FontSize="13"
                                    TextColor="#6B7280"
                                    Text="{Binding datePublished, StringFormat='{0:MMMM yyyy}'}" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Padding="10"
                                            Spacing="4"
                                            HorizontalOptions="End">

                                <Button
                                    Clicked="Update_Clicked"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Update"
                                    CommandParameter="{Binding .}"
                                    TextColor="Blue" />

                                <BoxView WidthRequest="70" HeightRequest="2"/>

                                <Button
                                    Command="{Binding DeleteBookCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Delete"
                                    TextColor="Red" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>
</ContentPage>