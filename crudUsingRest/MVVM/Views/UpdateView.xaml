<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.UpdateView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="UpdateView"
    x:DataType="vm:CRUDViewModel"
    BackgroundColor="#F9F6EE">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label
            FontAttributes="Bold"
            FontSize="24"
            HorizontalOptions="Center"
            Text="Update Book"
            TextColor="Black" />

        <Entry
            x:Name="txtTitle"
            Text="{Binding Title}"
            TextColor="Black" />
        <Entry
            x:Name="txtAuthor"
            Text="{Binding Author}"
            TextColor="Black" />

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">

            <Button
                BackgroundColor="#F3E5AB"
                Clicked="Update_Clicked"
                Command="{Binding UpdateBookCommand}"
                Text="Update"
                TextColor="Black" />

            <Button
                BackgroundColor="Transparent"
                BorderColor="Black"
                BorderWidth="2"
                Clicked="Cancel_Clicked"
                Text="Cancel"
                TextColor="Black"
                WidthRequest="120" />

        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>