<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.MainView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:crudUsingRest.MVVM.Models"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="MainView"
    x:DataType="vm:CRUDViewModel"
    Shell.NavBarIsVisible="False">

    <Grid
        Margin="10,15"
        RowDefinitions="Auto,*"
        RowSpacing="5">
        <VerticalStackLayout HorizontalOptions="Start">
            <Button
                Clicked="Create_Clicked"
                Style="{StaticResource CreateButtonStyle}"
                Text="Create New" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding _books}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Style="{StaticResource BookCardBorder}">
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout Spacing="4">
                                <Label Style="{StaticResource BookTitleLabel}" Text="{Binding title}" />

                                <Label Style="{StaticResource BookAuthorLabel}" Text="{Binding author}" />


                                <Label
                                    Margin="0,15,0,0"
                                    FontSize="13"
                                    Text="{Binding datePublished, StringFormat='{0:MMMM yyyy}'}" />
                            </VerticalStackLayout>

                            <Grid
                                Grid.Column="1"
                                ColumnDefinitions="Auto,Auto,Auto"
                                ColumnSpacing="5">

                                <Button
                                    Clicked="Update_Clicked"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Update"
                                    CommandParameter="{Binding .}"
                                    TextColor="Blue" />

                                <BoxView
                                    Grid.Column="1"
                                    HeightRequest="25"
                                    WidthRequest="1"
                                    Color="#D1D5DB" />

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding DeleteBookCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Delete"
                                    TextColor="Red" />

                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
    </Grid>

</ContentPage>