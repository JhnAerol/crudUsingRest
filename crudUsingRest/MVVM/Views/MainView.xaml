<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.MainView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:crudUsingRest.MVVM.Models"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="MainView"
    x:DataType="vm:CRUDViewModel"
    Shell.NavBarIsVisible="False">

    <Grid
        Margin="10,15"
        RowDefinitions="Auto,*"
        RowSpacing="5">
        <HorizontalStackLayout HorizontalOptions="Start" Spacing="5">
            <Button
                Clicked="Create_Clicked"
                Style="{StaticResource CreateButtonStyle}"
                Text="Create New" />
            <Button
                Clicked="GotoArchive_Clicked"
                Style="{StaticResource CreateButtonStyle}"
                Text="Go to Archive" />
        </HorizontalStackLayout>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding _books}"
            SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Style="{StaticResource BookCardBorder}">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">

                            <Image
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                HeightRequest="140"
                                Aspect="AspectFill"
                                Source="{Binding imagesBook}" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Grid.Column="0"
                                Padding="10"
                                Spacing="4">

                                <Label
                                    Style="{StaticResource BookTitleLabel}"
                                    Text="{Binding title}" />

                                <Label
                                    Style="{StaticResource BookAuthorLabel}"
                                    Text="{Binding author}" />

                                <Label
                                    Margin="0,24,0,0"
                                    FontSize="13"
                                    TextColor="#6B7280"
                                    Text="{Binding datePublished, StringFormat='{0:MMMM yyyy}'}" />

                            </VerticalStackLayout>

                            <VerticalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Padding="10"
                                            Spacing="4"
                                            HorizontalOptions="End">

                                <Button
                                    Clicked="Update_Clicked"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Update"
                                    CommandParameter="{Binding .}"
                                    TextColor="Blue" />

                                <BoxView WidthRequest="70" HeightRequest="2"/>

                                <Button
                                    Clicked="OpenOption_Clicked"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Text="Delete"
                                    TextColor="Red" />

                            </VerticalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        
        
            <Grid
            x:Name="optionOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            BackgroundColor="#80000000"
            IsVisible="False">

            <Border x:Name="optionContent" Style="{StaticResource BorderOverlay}">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.4"
                        Radius="15"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout>

                    <!--<Label
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Soft Delete">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SoftDelete_Tapped" />
                        </Label.GestureRecognizers>

                    </Label>-->
                    <Button FontSize="18"
                            Text="Soft Delete"
                            Command="{Binding SoftDeleteCommand}"
                            Clicked="SoftDelete_Tapped"
                            TextColor="Black"
                            Background="Transparent"
                            BorderWidth="2"
                            BorderColor="Black"/>

                    <BoxView
                        Margin="50,5"
                        BackgroundColor="#E0E0E0"
                        HeightRequest="2" />

                    <!--<Label
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Hard Delete">

                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="HardDelete_Tapped" />
                        </Label.GestureRecognizers>

                    </Label>-->
                    <Button FontSize="18"
                            Text="Hard Delete"
                            TextColor="Black"
                            Command="{Binding DeleteBookCommand}"
                            Clicked="HardDelete_Tapped"
                            Background="Transparent"
                            BorderWidth="2"
                            BorderColor="Black"/>

                    <Button
                        Margin="0,10,0,0"
                        Text="Cancel"
                        Clicked="CancelButton_Clicked"
                        Style="{StaticResource ButtonCancel}" />
                </VerticalStackLayout>

            </Border>

        </Grid>
        
    </Grid>

</ContentPage>