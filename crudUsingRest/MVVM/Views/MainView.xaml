<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="crudUsingRest.MVVM.Views.MainView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:crudUsingRest.MVVM.Models"
    xmlns:vm="clr-namespace:crudUsingRest.MVVM.ViewModels"
    Title="MainView"
    x:DataType="vm:CRUDViewModel"
    BackgroundColor="{StaticResource FreshBg}"
    Shell.NavBarIsVisible="False">

    <Grid
        Margin="10,15"
        RowDefinitions="Auto,*"
        RowSpacing="5">
        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,Auto"
            RowSpacing="8">

            <Label
                Grid.Row="0"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="My Library 📚"
                TextColor="{StaticResource FreshSlate}" />

            <Grid
                Grid.Row="1"
                ColumnDefinitions="*,*"
                ColumnSpacing="10">
                <Button
                    Grid.Column="0"
                    Clicked="Create_Clicked"
                    Style="{StaticResource CreateButtonStyle}"
                    Text="Add Book" />
                <Button
                    Grid.Column="1"
                    Clicked="GotoArchive_Clicked"
                    Style="{StaticResource CreateButtonStyle}"
                    Text="Archive" />
            </Grid>

        </Grid>

        <CollectionView
            Grid.Row="1"
            ItemsSource="{Binding _books}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <GridItemsLayout
                    HorizontalItemSpacing="10"
                    Orientation="Vertical"
                    Span="2"
                    VerticalItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Book">
                    <Border Style="{StaticResource BookCardBorder}">
                        <Grid RowDefinitions="Auto,*,Auto">

                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,10"
                                HeightRequest="150"
                                Stroke="{StaticResource FreshSky}"
                                StrokeThickness="2"
                                WidthRequest="150">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Image Aspect="AspectFill" Source="{Binding imagesBook}" />
                            </Border>

                            <VerticalStackLayout
                                Grid.Row="1"
                                Padding="10,10,10,0"
                                Spacing="4">

                                <Label
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2"
                                    Style="{StaticResource BookTitleLabel}"
                                    Text="{Binding title}" />

                                <Label
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Style="{StaticResource BookAuthorLabel}"
                                    Text="{Binding author}" />

                                <Label
                                    Margin="0,8,0,0"
                                    FontSize="13"
                                    Text="{Binding datePublished, StringFormat='{0:MMMM yyyy}'}"
                                    TextColor="#CC5500" />

                            </VerticalStackLayout>

                            <HorizontalStackLayout
                                Grid.Row="2"
                                Padding="10"
                                Spacing="8">

                                <Button
                                    Clicked="Update_Clicked"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource UpdateActionButtonStyle}"
                                    Text="Update" />

                                <Button
                                    Clicked="OpenOption_Clicked"
                                    Style="{StaticResource DeleteActionButtonStyle}"
                                    Text="Delete" />

                            </HorizontalStackLayout>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        <Grid
            x:Name="optionOverlay"
            Grid.Row="1"
            Grid.RowSpan="2"
            BackgroundColor="#80000000"
            IsVisible="False">

            <Border x:Name="optionContent" Style="{StaticResource BorderOverlay}">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.4"
                        Radius="15"
                        Offset="0,8" />
                </Border.Shadow>

                <VerticalStackLayout>

                    <Button
                        Background="Transparent"
                        BorderColor="Black"
                        BorderWidth="2"
                        Clicked="SoftDelete_Tapped"
                        Command="{Binding SoftDeleteCommand}"
                        FontSize="18"
                        Text="Soft Delete"
                        TextColor="Black" />

                    <BoxView
                        Margin="50,5"
                        BackgroundColor="#E0E0E0"
                        HeightRequest="2" />

                    <Button
                        Background="Transparent"
                        BorderColor="Black"
                        BorderWidth="2"
                        Clicked="HardDelete_Tapped"
                        Command="{Binding DeleteBookCommand}"
                        CommandParameter="{Binding .}"
                        FontSize="18"
                        Text="Hard Delete"
                        TextColor="Black" />

                    <Button
                        Margin="0,10,0,0"
                        Clicked="CancelButton_Clicked"
                        Style="{StaticResource ButtonCancel}"
                        Text="Cancel" />
                </VerticalStackLayout>

            </Border>

        </Grid>

    </Grid>

</ContentPage>