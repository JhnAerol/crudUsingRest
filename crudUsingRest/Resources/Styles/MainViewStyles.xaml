<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="crudUsingRest.Resources.Styles.MainViewStyles">

    <Style x:Key="BookCardBorder" TargetType="Border">
        <Setter Property="Stroke" Value="#FFFFFF"/>
        <Setter Property="StrokeThickness" Value="1.5"/>
        <Setter Property="BackgroundColor" Value="#40FFFFFF"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,8"/>

        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="20"/>
        </Setter>

        <Setter Property="Shadow">
            <Shadow
            Brush="#000000"
            Opacity="0.25"
            Radius="20"
            Offset="0,8"/>
        </Setter>
    </Style>
    
    <Style x:Key="BorderOverlay" TargetType="Border">
        <Setter Property="BackgroundColor" Value="#30FFFFFF"/>
        <Setter Property="Padding" Value="25"/>
        <Setter Property="Stroke" Value="#FFFFFF"/>
        <Setter Property="StrokeThickness" Value="1.5"/>

        <Setter Property="StrokeShape">
            <RoundRectangle CornerRadius="25"/>
        </Setter>

        <Setter Property="Shadow">
            <Shadow
            Brush="#000000"
            Opacity="0.3"
            Radius="25"
            Offset="0,10"/>
        </Setter>

        <Setter Property="WidthRequest" Value="320"/>
    </Style>

    <Style x:Key="ButtonCancel" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="#CCCCCC" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="TextColor" Value="#666666" />
        <Setter Property="Text" Value="cANCEL" />
    </Style>

    <Style x:Key="BookTitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="TextColor" Value="White"/>
    </Style>

    <Style x:Key="BookAuthorLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="TextColor" Value="#E5E7EB"/>
    </Style>

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="CreateButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#30FFFFFF"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="BorderColor" Value="#80FFFFFF"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>

</ResourceDictionary>