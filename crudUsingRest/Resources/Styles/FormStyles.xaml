<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="crudUsingRest.Resources.Styles.FormStyles">

    <Style x:Key="FormTitleStyle" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="#111827"/>
    </Style>

    <Style x:Key="FormEntryStyle" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="#20FFFFFF"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="PlaceholderColor" Value="#DDDDDD"/>
        <Setter Property="Margin" Value="0,5"/>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#2563EB"/>
        <Setter Property="TextColor" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="WidthRequest" Value="120"/>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="BackgroundColor" Value="#E5E7EB"/>
        <Setter Property="TextColor" Value="#111827"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="WidthRequest" Value="120"/>
    </Style>

</ResourceDictionary>