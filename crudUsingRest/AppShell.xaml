<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="crudUsingRest.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:crudUsingRest.MVVM.Views"
    Title="crudUsingRest">

    <ShellContent
        ContentTemplate="{DataTemplate local:MainView}"
        Route="MainView" />
    <ShellContent
        ContentTemplate="{DataTemplate local:CreateView}"
        Route="CreateView" />
    <ShellContent
        ContentTemplate="{DataTemplate local:UpdateView}"
        Route="UpdateView" />

</Shell>
